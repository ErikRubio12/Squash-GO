# Local-dev env for `supabase functions serve`.
# Copy to `.env` (which IS gitignored), fill in real values, never commit.
#
# Resolve from:
#   SUPABASE_URL                  → Supabase dashboard → Project Settings → API → Project URL
#   SUPABASE_SERVICE_ROLE_KEY     → Supabase dashboard → Project Settings → API → service_role key (secret!)
#   FCM_PROJECT_ID                → Firebase Console → Project Settings → General → Project ID
#   FCM_SERVICE_ACCOUNT_JSON      → entire JSON file from Firebase → Project Settings → Service accounts → Generate new private key
#                                   Pass it as a single line, escape internal quotes, OR keep multi-line; supabase CLI handles both via --env-file.
#   INTERNAL_FN_SHARED_SECRET     → openssl rand -hex 32 (must MATCH Postgres custom config app.internal_fn_secret once triggers exist)

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
INTERNAL_FN_SHARED_SECRET=
